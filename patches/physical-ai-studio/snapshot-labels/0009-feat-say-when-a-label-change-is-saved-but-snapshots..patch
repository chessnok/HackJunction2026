 .../src/runtime_session/snapshot_index.py     |  9 +++---
 .../backend/src/schemas/state_snapshot.py     |  5 ++++
 .../tests/runtime_session/test_snapshot.py    |  3 ++
 .../runtime_session/test_snapshot_index.py    |  8 ++++--
 .../state-snapshot-controls.tsx               |  6 ++++
 .../runtime-session/state-snapshot.test.tsx   | 28 +++++++++++++++++--
 7 files changed, 59 insertions(+), 10 deletions(-)

diff --git a/application/backend/src/runtime_session/snapshot.py b/application/backend/src/runtime_session/snapshot.py
index bb060e7b..098638ad 100644
--- a/application/backend/src/runtime_session/snapshot.py
+++ b/application/backend/src/runtime_session/snapshot.py
@@ -216,8 +216,14 @@ def update_label(
         changes["defective"] = defective
     if comment is not None:
         changes["comment"] = comment
-    document = snapshot_index.update(project_root, snapshot_id, changes)
-    return _summary(project_root / snapshot_id, document)
+    document, index_error = snapshot_index.update(project_root, snapshot_id, changes)
+    summary = _summary(project_root / snapshot_id, document)
+    if index_error is not None:
+        summary.csv_warning = (
+            f"The label is saved, but {snapshot_index.CSV_NAME} could not be rewritten ({index_error}); "
+            "the next capture or CSV download brings it up to date."
+        )
+    return summary
 
 
 def _summary(folder: Path, document: dict[str, Any]) -> StateSnapshot:
diff --git a/application/backend/src/runtime_session/snapshot_index.py b/application/backend/src/runtime_session/snapshot_index.py
index 5f67016d..1211fec2 100644
--- a/application/backend/src/runtime_session/snapshot_index.py
+++ b/application/backend/src/runtime_session/snapshot_index.py
@@ -193,14 +193,14 @@ def contents(project_root: Path, *, rebuild_first: bool = False) -> bytes:
         return (project_root / CSV_NAME).read_bytes()
 
 
-def update(project_root: Path, snapshot_id: str, changes: dict[str, Any]) -> dict[str, Any]:
+def update(project_root: Path, snapshot_id: str, changes: dict[str, Any]) -> tuple[dict[str, Any], OSError | None]:
     """Change fields of a snapshot's ``state.json`` (such as its label), then rebuild the index.
 
     The index is marked stale first. If it cannot be rebuilt once ``state.json`` is changed, the
     change stands and the index stays marked, for the next capture or download to rebuild it.
 
     Returns:
-        The updated ``state.json``.
+        The updated ``state.json``, and why the index could not be rebuilt, if it could not.
 
     Raises:
         FileNotFoundError: There is no such snapshot.
@@ -216,9 +216,10 @@ def update(project_root: Path, snapshot_id: str, changes: dict[str, Any]) -> dic
         write_json(folder / STATE_FILE, document)
         try:
             _rebuild_locked(project_root)
-        except OSError:
+        except OSError as error:
             logger.exception("Changed {} but could not rebuild {}; the next check will", folder.name, CSV_NAME)
-        return document
+            return document, error
+        return document, None
 
 
 def write_json(path: Path, document: dict[str, Any]) -> None:
