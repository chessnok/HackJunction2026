+                profiles += [_profile("depth", "z16", *mode) for mode in USB3_DEPTH]
+                profiles.append(_profile("color", "yuyv", 1920, 1080, 60))  # not rgb8: ignored
+                return [SimpleNamespace(get_stream_profiles=lambda: profiles)]
