diff --git a/application/backend/src/trainer/modal_app.py b/application/backend/src/trainer/modal_app.py
index 5dbda125..8b8b62b7 100644
--- a/application/backend/src/trainer/modal_app.py
+++ b/application/backend/src/trainer/modal_app.py
@@ -1,14 +1,30 @@
 # Copyright (C) 2026 Intel Corporation
 # SPDX-License-Identifier: Apache-2.0
 
-"""Deploy with `modal deploy application/modal/train.py` from the repository root."""
+"""Deploy with `modal deploy application/modal/train.py` from the repository root.
+
+The registry image provides the training environment (Python, PyTorch, the
+``physicalai`` library) together with an upstream copy of the ``trainer`` and
+``training`` packages. The deployment overlays this checkout's own copies of
+those two packages, which :func:`train` puts first on ``sys.path``, so a Modal
+run executes the same training code as the Studio that deployed it (for
+example, the spec fields Studio sends). Redeploy after changing them.
+"""
 
 import os
+import sys
 from pathlib import Path
 from uuid import UUID
 
 import modal
 
+STUDIO_SOURCE_DIR = "/opt/physicalai-studio/src"
+"""Where this checkout's ``trainer`` and ``training`` packages are mounted in the container."""
+
+_OVERLAID_PACKAGES = ("trainer", "training")
+# Parent of this file's package; only meaningful where the app is deployed from.
+_LOCAL_SOURCE_DIR = Path(__file__).resolve().parents[1]
+
 app = modal.App(os.environ.get("PHYSICALAI_MODAL_APP", "physicalai-trainer"))
 volume = modal.Volume.from_name(
     os.environ.get("PHYSICALAI_MODAL_VOLUME", "physicalai-training"), create_if_missing=True
@@ -18,6 +34,12 @@ image = modal.Image.from_registry(
     # The trainer image strips pip; Modal needs it to install its container runtime.
     setup_dockerfile_commands=["RUN python -m ensurepip --default-pip"],
 )
+for _package in _OVERLAID_PACKAGES:
+    image = image.add_local_dir(
+        _LOCAL_SOURCE_DIR / _package,
+        f"{STUDIO_SOURCE_DIR}/{_package}",
+        ignore=lambda path: "__pycache__" in Path(path).parts,
+    )
 secret_name = os.environ.get("PHYSICALAI_MODAL_SECRET")
 
 
@@ -35,6 +57,10 @@ def train(job_id: str) -> int:
     """Run the existing batch worker; expose only UUID-named job directories."""
     import shutil
 
+    # Before the first import of either package: the overlaid source wins over the image's copy.
+    if Path(STUDIO_SOURCE_DIR).is_dir() and STUDIO_SOURCE_DIR not in sys.path:
+        sys.path.insert(0, STUDIO_SOURCE_DIR)
+
     from trainer.batch import BatchSettings, LocalDirJobStorage, run
     from trainer.batch.status import BatchJobStatus
     from trainer.settings import get_settings
diff --git a/application/backend/tests/services/test_modal_worker.py b/application/backend/tests/services/test_modal_worker.py
index 5912e1f4..fa3ac1d5 100644
--- a/application/backend/tests/services/test_modal_worker.py
+++ b/application/backend/tests/services/test_modal_worker.py
@@ -67,3 +67,57 @@ def test_modal_worker_commits_and_cleans_local_outputs(monkeypatch, tmp_path, jo
     config = app.function.call_args.kwargs
     assert config["timeout"] == 24 * 60 * 60 and config["retries"] == 0
     assert config["volumes"] == {"/training-jobs": volume}
+
+
+def test_modal_image_overlays_this_checkouts_trainer_and_training_code(monkeypatch):
+    """The registry image's copy may be older; a deployment must train with the code Studio speaks."""
+    import sys
+
+    image = MagicMock()
+    image.add_local_dir.return_value = image
+    sdk = SimpleNamespace(App=MagicMock(), Volume=MagicMock(), Image=MagicMock(), Secret=MagicMock())
+    sdk.Image.from_registry.return_value = image
+    sdk.App.return_value.function.side_effect = lambda **kwargs: lambda function: function
+    monkeypatch.setitem(sys.modules, "modal", sdk)
+    source = Path(__file__).parents[2] / "src"
+
+    worker = runpy.run_path(str(source / "trainer" / "modal_app.py"))
+
+    overlays = [(call.args[0], call.args[1]) for call in image.add_local_dir.call_args_list]
+    assert overlays == [
+        (source / "trainer", f"{worker['STUDIO_SOURCE_DIR']}/trainer"),
+        (source / "training", f"{worker['STUDIO_SOURCE_DIR']}/training"),
+    ]
+    assert (source / "training" / "early_stopping.py").is_file()
+    ignore = image.add_local_dir.call_args.kwargs["ignore"]
+    assert ignore(Path("training/__pycache__/job.cpython-313.pyc"))
+    assert not ignore(Path("training/job.py"))
+    assert sdk.App.return_value.function.call_args.kwargs["image"] is image
+
+
+def test_modal_worker_imports_the_overlaid_code_first(monkeypatch, tmp_path):
+    import sys
+
+    app = MagicMock()
+    app.function.side_effect = lambda **kwargs: lambda function: function
+    sdk = SimpleNamespace(App=MagicMock(return_value=app), Volume=MagicMock(), Image=MagicMock(), Secret=MagicMock())
+    monkeypatch.setitem(sys.modules, "modal", sdk)
+    worker = runpy.run_path(str(Path(__file__).parents[2] / "src" / "trainer" / "modal_app.py"))
+    overlay = tmp_path / "overlay"
+    overlay.mkdir()
+    worker["train"].__globals__["STUDIO_SOURCE_DIR"] = str(overlay)
+    monkeypatch.setattr(sys, "path", list(sys.path))
+    seen: list[str] = []
+
+    def run(_storage, _settings):
+        seen.append(sys.path[0])
+        return 0
+
+    monkeypatch.setattr("trainer.batch.run", run)
+    monkeypatch.setattr(
+        "trainer.settings.get_settings",
+        lambda: SimpleNamespace(storage_dir=tmp_path, models_dir=tmp_path / "models", archives_dir=tmp_path / "a"),
+    )
+
+    assert worker["train"](str(uuid4())) == 0
+    assert seen == [str(overlay)]
