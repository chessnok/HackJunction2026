@@ -83,6 +106,7 @@ def ensure_depth_preview(video_path: Path, cache_dir: Path, info: Mapping[str, A
                 partial.replace(preview)
             finally:
                 partial.unlink(missing_ok=True)
+            _evict(preview)
     return preview
 
 
