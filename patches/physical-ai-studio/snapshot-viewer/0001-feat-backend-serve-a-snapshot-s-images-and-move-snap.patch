+IMAGE_NAME = re.compile(r"\w[\w .+-]*\.(color|depth|depth_preview)\.png")
+"""How a snapshot's image files are named: ``<camera>.color.png``, ``.depth.png``, ``.depth_preview.png``."""
 
 
 @dataclass
