 .../backend/src/runtime_session/session.py    | 19 ++++++++++------
 .../tests/runtime_session/test_recording.py   | 18 +++++++++++++++
 3 files changed, 52 insertions(+), 7 deletions(-)

diff --git a/application/backend/src/runtime_session/dataset.py b/application/backend/src/runtime_session/dataset.py
